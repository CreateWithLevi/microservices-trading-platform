# Terraform Variables Example File
# Copy this file to terraform.tfvars and customize for your environment
#
# Usage:
#   cp terraform.tfvars.example terraform.tfvars
#   # Edit terraform.tfvars with your values
#   terraform plan
#   terraform apply

# ==============================================================================
# PRODUCTION CONFIGURATION (Recommended)
# ==============================================================================

# General Configuration
aws_region   = "us-east-1"
project_name = "trading-platform"
environment  = "prod"

# VPC Configuration
vpc_cidr            = "10.0.0.0/16"
availability_zones  = ["us-east-1a", "us-east-1b", "us-east-1c"]
public_subnet_cidrs = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]
private_subnet_cidrs = ["10.0.10.0/24", "10.0.11.0/24", "10.0.12.0/24"]
database_subnet_cidrs = ["10.0.20.0/24", "10.0.21.0/24", "10.0.22.0/24"]

# EKS Configuration
eks_cluster_version    = "1.28"
eks_node_instance_types = ["t3.medium"]  # 2 vCPU, 4 GiB RAM
eks_node_desired_size  = 3               # Spread across 3 AZs
eks_node_min_size      = 2               # Minimum for high availability
eks_node_max_size      = 6               # Maximum for auto-scaling

# ECR Configuration
ecr_repositories = [
  "service-a",
  "service-b",
  "service-c",
  "service-d",
  "service-e",
  "service-n",
  "frontend"
]

# RDS Configuration (PostgreSQL for TimescaleDB/Kong)
rds_instance_class        = "db.t3.medium"  # 2 vCPU, 4 GiB RAM
rds_allocated_storage     = 100             # GB (will auto-scale to 200GB)
rds_engine_version        = "15.4"
rds_database_name         = "tradingdb"
rds_master_username       = "dbadmin"
rds_multi_az              = true            # High availability
rds_backup_retention_days = 7               # 7-day backup retention

# ElastiCache Configuration (Redis)
redis_node_type                = "cache.t3.medium"  # 2 vCPU, 3.09 GiB RAM
redis_num_cache_nodes          = 2                  # Primary + 1 replica
redis_engine_version           = "7.0"
redis_parameter_group_family   = "redis7"
redis_automatic_failover_enabled = true             # High availability

# Amazon MQ Configuration (RabbitMQ)
mq_broker_instance_type = "mq.t3.micro"        # 2 vCPU, 1 GiB RAM
mq_engine_version       = "3.11.20"
mq_deployment_mode      = "CLUSTER_MULTI_AZ"   # High availability
mq_username             = "admin"

